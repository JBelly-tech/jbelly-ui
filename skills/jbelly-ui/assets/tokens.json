{
  "$schema": "https://www.designtokens.org/schema",
  "color": {
    "destructive-accent": {
      "$type": "color",
      "$value": "oklch(57.5% 0.22 27)",
      "$extensions": {
        "modes": {
          "dark": "oklch(60.25% 0.22 27)"
        }
      }
    },
    "background": {
      "$type": "color",
      "$value": "oklch(100% 0 0)",
      "$extensions": {
        "modes": {
          "dark": "oklch(14.5% 0.005 285)"
        }
      }
    },
    "foreground": {
      "$type": "color",
      "$value": "oklch(14.5% 0.005 285)",
      "$extensions": {
        "modes": {
          "dark": "oklch(98.5% 0 0)"
        }
      }
    },
    "card": {
      "$type": "color",
      "$value": "oklch(100% 0 0)",
      "$extensions": {
        "modes": {
          "dark": "oklch(14.5% 0.005 285)"
        }
      }
    },
    "card-foreground": {
      "$type": "color",
      "$value": "oklch(14.5% 0.005 285)",
      "$extensions": {
        "modes": {
          "dark": "oklch(98.5% 0 0)"
        }
      }
    },
    "popover": {
      "$type": "color",
      "$value": "oklch(100% 0 0)",
      "$extensions": {
        "modes": {
          "dark": "oklch(14.5% 0.005 285)"
        }
      }
    },
    "popover-foreground": {
      "$type": "color",
      "$value": "oklch(14.5% 0.005 285)",
      "$extensions": {
        "modes": {
          "dark": "oklch(98.5% 0 0)"
        }
      }
    },
    "primary": {
      "$type": "color",
      "$value": "oklch(48% 0.13 255)",
      "$extensions": {
        "modes": {
          "dark": "oklch(50% 0.13 255)"
        }
      }
    },
    "primary-accent": {
      "$type": "color",
      "$value": "oklch(48% 0.13 255)",
      "$extensions": {
        "modes": {
          "dark": "oklch(68% 0.11 255)"
        }
      }
    },
    "primary-foreground": {
      "$type": "color",
      "$value": "oklch(100% 0 0)",
      "$extensions": {
        "modes": {
          "dark": "oklch(100% 0 0)"
        }
      }
    },
    "secondary": {
      "$type": "color",
      "$value": "oklch(96.5% 0.002 285)",
      "$extensions": {
        "modes": {
          "dark": "oklch(27.5% 0.006 286)"
        }
      }
    },
    "secondary-foreground": {
      "$type": "color",
      "$value": "oklch(21% 0.006 285)",
      "$extensions": {
        "modes": {
          "dark": "oklch(98.5% 0 0)"
        }
      }
    },
    "muted": {
      "$type": "color",
      "$value": "oklch(96.5% 0.002 285)",
      "$extensions": {
        "modes": {
          "dark": "oklch(21% 0.006 285)"
        }
      }
    },
    "muted-foreground": {
      "$type": "color",
      "$value": "oklch(55% 0.014 285)",
      "$extensions": {
        "modes": {
          "dark": "oklch(64% 0.014 285)"
        }
      }
    },
    "accent": {
      "$type": "color",
      "$value": "oklch(96.5% 0.002 285)",
      "$extensions": {
        "modes": {
          "dark": "oklch(21% 0.006 285)"
        }
      }
    },
    "accent-foreground": {
      "$type": "color",
      "$value": "oklch(21% 0.006 285)",
      "$extensions": {
        "modes": {
          "dark": "oklch(98.5% 0 0)"
        }
      }
    },
    "mono": {
      "$type": "color",
      "$value": "oklch(14.5% 0.005 285)",
      "$extensions": {
        "modes": {
          "dark": "oklch(87% 0.006 286)"
        }
      }
    },
    "mono-foreground": {
      "$type": "color",
      "$value": "oklch(100% 0 0)",
      "$extensions": {
        "modes": {
          "dark": "oklch(0% 0 0)"
        }
      }
    },
    "destructive": {
      "$type": "color",
      "$value": "oklch(57.5% 0.22 27)",
      "$extensions": {
        "modes": {
          "dark": "oklch(57.5% 0.22 27)"
        }
      }
    },
    "destructive-foreground": {
      "$type": "color",
      "$value": "oklch(100% 0 0)",
      "$extensions": {
        "modes": {
          "dark": "oklch(100% 0 0)"
        }
      }
    },
    "success": {
      "$type": "color",
      "$value": "oklch(72% 0.19 150)",
      "$extensions": {
        "modes": {
          "dark": "oklch(72% 0.19 150)"
        }
      }
    },
    "success-foreground": {
      "$type": "color",
      "$value": "oklch(100% 0 0)",
      "$extensions": {
        "modes": {
          "dark": "oklch(100% 0 0)"
        }
      }
    },
    "warning": {
      "$type": "color",
      "$value": "oklch(85% 0.17 90)",
      "$extensions": {
        "modes": {
          "dark": "oklch(85% 0.17 90)"
        }
      }
    },
    "warning-foreground": {
      "$type": "color",
      "$value": "oklch(30% 0.05 90)",
      "$extensions": {
        "modes": {
          "dark": "oklch(92% 0.12 90)"
        }
      }
    },
    "info": {
      "$type": "color",
      "$value": "oklch(56% 0.15 293)",
      "$extensions": {
        "modes": {
          "dark": "oklch(56% 0.15 293)"
        }
      }
    },
    "info-foreground": {
      "$type": "color",
      "$value": "oklch(100% 0 0)",
      "$extensions": {
        "modes": {
          "dark": "oklch(100% 0 0)"
        }
      }
    },
    "border": {
      "$type": "color",
      "$value": "oklch(94% 0.004 286)",
      "$extensions": {
        "modes": {
          "dark": "oklch(27.5% 0.006 286)"
        }
      }
    },
    "input": {
      "$type": "color",
      "$value": "oklch(92% 0.004 286)",
      "$extensions": {
        "modes": {
          "dark": "oklch(27.5% 0.006 286)"
        }
      }
    },
    "ring": {
      "$type": "color",
      "$value": "oklch(71% 0.01 286)",
      "$extensions": {
        "modes": {
          "dark": "oklch(44% 0.01 286)"
        }
      }
    },
    "sidebar": {
      "$type": "color",
      "$value": "var(--card)",
      "$extensions": {
        "modes": {
          "dark": "var(--card)"
        }
      }
    },
    "sidebar-foreground": {
      "$type": "color",
      "$value": "var(--foreground)",
      "$extensions": {
        "modes": {
          "dark": "var(--foreground)"
        }
      }
    },
    "sidebar-muted": {
      "$type": "color",
      "$value": "var(--muted-foreground)",
      "$extensions": {
        "modes": {
          "dark": "var(--muted-foreground)"
        }
      }
    },
    "sidebar-accent": {
      "$type": "color",
      "$value": "var(--accent)",
      "$extensions": {
        "modes": {
          "dark": "var(--accent)"
        }
      }
    },
    "sidebar-accent-foreground": {
      "$type": "color",
      "$value": "var(--accent-foreground)",
      "$extensions": {
        "modes": {
          "dark": "var(--accent-foreground)"
        }
      }
    },
    "sidebar-primary": {
      "$type": "color",
      "$value": "var(--primary)",
      "$extensions": {
        "modes": {
          "dark": "var(--primary)"
        }
      }
    },
    "sidebar-border": {
      "$type": "color",
      "$value": "var(--border)",
      "$extensions": {
        "modes": {
          "dark": "var(--border)"
        }
      }
    }
  },
  "font": {
    "display": {
      "$type": "fontFamily",
      "$value": [
        "Inter",
        "ui-sans-serif",
        "system-ui",
        "sans-serif"
      ]
    },
    "sans": {
      "$type": "fontFamily",
      "$value": [
        "Inter",
        "ui-sans-serif",
        "system-ui",
        "-apple-system",
        "Segoe UI",
        "Roboto",
        "Noto Sans Arabic",
        "Helvetica Neue",
        "Arial",
        "sans-serif"
      ]
    },
    "mono": {
      "$type": "fontFamily",
      "$value": [
        "ui-monospace",
        "JetBrains Mono",
        "Cascadia Mono",
        "Consolas",
        "Liberation Mono",
        "monospace"
      ]
    }
  },
  "radius": {
    "base": {
      "$type": "dimension",
      "$value": "0.5rem"
    },
    "xl": {
      "$type": "dimension",
      "$value": "calc(0.5rem + 4px)"
    },
    "lg": {
      "$type": "dimension",
      "$value": "0.5rem"
    },
    "md": {
      "$type": "dimension",
      "$value": "calc(0.5rem - 2px)"
    },
    "sm": {
      "$type": "dimension",
      "$value": "calc(0.5rem - 4px)"
    }
  },
  "shadow": {
    "xs": {
      "$type": "shadow",
      "$value": "0 1px 2px 0 rgb(0 0 0 / 0.05)",
      "$extensions": {
        "modes": {
          "dark": "0 1px 2px 0 rgb(0 0 0 / 0.4)"
        }
      }
    },
    "md": {
      "$type": "shadow",
      "$value": "0 4px 6px -1px rgb(0 0 0 / 0.08), 0 2px 4px -2px rgb(0 0 0 / 0.06)",
      "$extensions": {
        "modes": {
          "dark": "0 4px 6px -1px rgb(0 0 0 / 0.5), 0 2px 4px -2px rgb(0 0 0 / 0.4)"
        }
      }
    }
  },
  "layout": {
    "sidebar-width": {
      "$type": "dimension",
      "$value": "280px"
    },
    "sidebar-width-collapsed": {
      "$type": "dimension",
      "$value": "80px"
    },
    "header-height": {
      "$type": "dimension",
      "$value": "70px"
    }
  }
}